{
  "name": "conformance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/conformance/src",
  "projectType": "application",
  "tags": ["type:test", "runtime:node"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc -p apps/conformance/tsconfig.lib.json --noEmit",
          "tsc -p apps/conformance/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --config apps/conformance/vitest.config.mts"
      }
    },
    "it": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node libs/testkit/src/it/run-it.ts conformance",
        "cwd": "{workspaceRoot}"
      }
    },
    "record": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node libs/testkit/src/it/run-record.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
