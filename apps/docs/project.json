{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/docs"],
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/src/content/docs/adr/**",
        "!{projectRoot}/.astro/**",
        "{workspaceRoot}/docs/adr/**",
        "{workspaceRoot}/pnpm-workspace.yaml"
      ],
      "options": {
        "cwd": "apps/docs",
        "commands": ["astro build", "node tools/verify-build.mjs"],
        "parallel": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/docs",
        "command": "astro dev"
      }
    }
  }
}
