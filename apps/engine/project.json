{
  "name": "engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/engine/src",
  "tags": ["type:app", "runtime:node"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": true,
        "outputPath": "dist/apps/engine",
        "main": "apps/engine/src/main.ts",
        "tsConfig": "apps/engine/tsconfig.app.json",
        "outputFileName": "main.mjs",
        "metafile": true,
        "esbuildOptions": {
          "outExtension": { ".js": ".mjs" },
          "alias": {
            "pg-native": "./apps/engine/src/optional-addon-absent.ts",
            "bufferutil": "./apps/engine/src/optional-addon-absent.ts",
            "utf-8-validate": "./apps/engine/src/optional-addon-absent.ts"
          },
          "banner": {
            "js": "import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);"
          }
        }
      },
      "configurations": {
        "development": { "minify": false, "sourcemap": true },
        "production": { "minify": false, "sourcemap": true }
      }
    },
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc -p apps/engine/tsconfig.app.json --noEmit",
          "tsc -p apps/engine/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --config apps/engine/vitest.config.mts"
      }
    },
    "egress": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "vitest run --config apps/engine/vitest.smoke.config.mts -t egress",
        "env": { "EGRESS_SOAK_SECONDS": "600" }
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "vitest run --config apps/engine/vitest.smoke.config.mts"
      }
    }
  }
}
