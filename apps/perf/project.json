{
  "name": "perf",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/perf/src",
  "projectType": "library",
  "tags": ["type:test", "runtime:node"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc -p apps/perf/tsconfig.lib.json --noEmit",
          "tsc -p apps/perf/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --config apps/perf/vitest.config.mts"
      }
    },
    "explorer-ui-20k": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/perf/vitest.perf.config.mts src/explorer-ui-20k/explorer-ui-20k.perf.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "explorer-ui-20k-browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [{ "projects": ["web", "engine"], "target": "build" }],
      "options": {
        "command": "vitest run --config apps/perf/vitest.perf.config.mts src/explorer-ui-20k/explorer-ui-20k.browser.perf.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "metrics-100k": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/perf/vitest.perf.config.mts src/metrics-100k",
        "cwd": "{workspaceRoot}"
      }
    },
    "explorer-20k": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/perf/vitest.perf.config.mts src/explorer-20k",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
