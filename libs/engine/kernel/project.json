{
  "name": "kernel",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/engine/kernel/src",
  "projectType": "library",
  "tags": ["type:kernel", "runtime:node"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc -p libs/engine/kernel/tsconfig.lib.json --noEmit",
          "tsc -p libs/engine/kernel/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --config libs/engine/kernel/vitest.config.mts"
      }
    }
  }
}
