{
  "name": "net-dialer",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/engine/net-dialer/src",
  "projectType": "library",
  "tags": ["type:net", "runtime:node", "trust:critical"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc -p libs/engine/net-dialer/tsconfig.lib.json --noEmit",
          "tsc -p libs/engine/net-dialer/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --config libs/engine/net-dialer/vitest.config.mts"
      }
    },
    "outbound-calls": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node libs/engine/net-dialer/src/emit-outbound-calls.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "outbound-calls-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/purposes.ts",
        "{projectRoot}/src/outbound-calls-page.ts",
        "{projectRoot}/src/emit-outbound-calls.ts",
        "{workspaceRoot}/apps/docs/src/content/docs/security/outbound-calls.md"
      ],
      "options": {
        "command": "node libs/engine/net-dialer/src/emit-outbound-calls.ts --check",
        "cwd": "{workspaceRoot}"
      }
    },
    "it": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node libs/testkit/src/it/run-it.ts net-dialer",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
