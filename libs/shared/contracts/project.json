{
  "name": "contracts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/contracts/src",
  "projectType": "library",
  "tags": ["type:contracts", "runtime:isomorphic"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc -p libs/shared/contracts/tsconfig.lib.json --noEmit",
          "tsc -p libs/shared/contracts/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --config libs/shared/contracts/vitest.config.mts"
      }
    },
    "api-docs": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --import ./tools/api-docs/register.mjs tools/api-docs/emit-specs.ts"
      }
    },
    "api-docs-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/!(*.spec).ts",
        "{workspaceRoot}/tools/api-docs/emit-specs.ts",
        "{workspaceRoot}/docs/api/*.json",
        { "externalDependencies": ["zod"] }
      ],
      "options": {
        "command": "node --import ./tools/api-docs/register.mjs tools/api-docs/emit-specs.ts --check"
      }
    }
  }
}
