{
  "name": "testkit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/testkit/src",
  "projectType": "library",
  "tags": ["type:test", "runtime:node"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc -p libs/testkit/tsconfig.lib.json --noEmit",
          "tsc -p libs/testkit/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --config libs/testkit/vitest.config.mts"
      }
    },
    "seed-lab": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "node libs/testkit/src/it/seed-lab.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
