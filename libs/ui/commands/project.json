{
  "name": "ui-commands",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/commands/src",
  "projectType": "library",
  "tags": ["type:ui-lib", "runtime:browser"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "ngc -p libs/ui/commands/tsconfig.lib.json --noEmit",
          "ngc -p libs/ui/commands/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --config libs/ui/commands/vitest.config.mts"
      },
      "dependsOn": ["test-components"]
    },
    "test-components": {
      "executor": "@angular/build:unit-test",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "buildTarget": "web:build:development",
        "tsConfig": "libs/ui/commands/tsconfig.spec.json",
        "runner": "vitest",
        "runnerConfig": "libs/ui/commands/vitest.components.config.mts",
        "watch": false,
        "include": ["**/*.component.spec.ts"]
      }
    }
  }
}
