{
  "name": "ui-grid",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/grid/src",
  "projectType": "library",
  "tags": ["type:ui-lib", "runtime:browser"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "ngc -p libs/ui/grid/tsconfig.lib.json --noEmit",
          "ngc -p libs/ui/grid/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "dependsOn": ["test-components"],
      "options": {
        "command": "vitest run --config libs/ui/grid/vitest.config.mts"
      }
    },
    "bundle-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/grid-bundle-check/**/*",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "options": {
        "command": "node tools/grid-bundle-check/bundle-check.mjs"
      }
    },
    "test-components": {
      "executor": "@angular/build:unit-test",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "buildTarget": "web:build:development",
        "tsConfig": "libs/ui/grid/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false,
        "include": [
          "**/{data-grid.component,context-menu,status-bar,column-chooser}.spec.ts"
        ]
      }
    }
  }
}
