# The build context of packaging/docker/Dockerfile (BuildKit reads <Dockerfile>.dockerignore first).
# The image build installs and builds from the lockfile, so nothing built or installed on the
# developer's machine goes in, and nothing that holds a secret or a machine path.
**/node_modules
**/dist
**/tmp
**/coverage
**/.angular
**/.nx
.git
.github
.claude
.vscode
.idea
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.kek
*.log
# Not needed to build the engine or the web app.
docs
spikes
testing
