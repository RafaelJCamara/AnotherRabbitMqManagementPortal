{
  "permissions": [
    {
      "configure": ".*",
      "read": ".*",
      "user": "guest",
      "vhost": "/",
      "write": ".*"
    },
    {
      "configure": "^golden\\.",
      "read": ".*",
      "user": "golden-monitor",
      "vhost": "golden",
      "write": "^golden\\."
    },
    {
      "configure": ".*",
      "read": ".*",
      "user": "guest",
      "vhost": "golden",
      "write": ".*"
    }
  ],
  "rabbitmq_version": "4.2.9",
  "product_name": "RabbitMQ",
  "product_version": "4.2.9",
  "rabbit_version": "4.2.9",
  "exchanges": [
    {
      "arguments": {},
      "auto_delete": false,
      "durable": true,
      "name": "amq.rabbitmq.log",
      "type": "topic",
      "vhost": "/"
    },
    {
      "arguments": {},
      "auto_delete": false,
      "durable": true,
      "name": "golden.direct",
      "type": "direct",
      "vhost": "golden"
    },
    {
      "arguments": {},
      "auto_delete": false,
      "durable": true,
      "name": "golden.dlx",
      "type": "fanout",
      "vhost": "golden"
    },
    {
      "arguments": {},
      "auto_delete": false,
      "durable": true,
      "name": "golden.hash",
      "type": "x-consistent-hash",
      "vhost": "golden"
    },
    {
      "arguments": {
        "alternate-exchange": "golden.dlx"
      },
      "auto_delete": false,
      "durable": true,
      "name": "golden.topic",
      "type": "topic",
      "vhost": "golden"
    }
  ],
  "vhosts": [
    {
      "limits": {},
      "metadata": {
        "description": "Default virtual host",
        "tags": [],
        "default_queue_type": "classic"
      },
      "name": "/"
    },
    {
      "limits": {},
      "metadata": {
        "description": "golden fixtures",
        "tags": [
          "golden",
          "fixtures"
        ],
        "default_queue_type": "classic"
      },
      "name": "golden"
    }
  ],
  "users": [
    {
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "limits": {},
      "name": "golden-monitor",
      "password_hash": "<scrubbed>",
      "tags": [
        "monitoring"
      ]
    },
    {
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "limits": {},
      "name": "golden-plain",
      "password_hash": "<scrubbed>",
      "tags": []
    },
    {
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "limits": {},
      "name": "guest",
      "password_hash": "<scrubbed>",
      "tags": [
        "administrator"
      ]
    }
  ],
  "global_parameters": [
    {
      "name": "cluster_tags",
      "value": []
    }
  ],
  "parameters": [
    {
      "component": "operator_policy",
      "name": "golden-op",
      "value": {
        "apply-to": "queues",
        "definition": {
          "max-length": 100000
        },
        "pattern": "^golden\\.classic$",
        "priority": 1
      },
      "vhost": "golden"
    }
  ],
  "policies": [
    {
      "apply-to": "queues",
      "definition": {
        "delivery-limit": 7
      },
      "name": "golden-delivery-limit",
      "pattern": "^golden\\.quorum$",
      "priority": 1,
      "vhost": "golden"
    },
    {
      "apply-to": "queues",
      "definition": {
        "message-ttl": 600000
      },
      "name": "golden-ttl",
      "pattern": "^golden\\.classic$",
      "priority": 1,
      "vhost": "golden"
    }
  ],
  "topic_permissions": [],
  "explanation": "Definitions of cluster 'rabbit@lab-node'",
  "rabbitmq_definition_format": "cluster",
  "original_cluster_name": "rabbit@lab-node",
  "queues": [
    {
      "arguments": {
        "x-queue-type": "classic"
      },
      "auto_delete": false,
      "durable": true,
      "name": "golden.dead",
      "type": "classic",
      "vhost": "golden"
    },
    {
      "arguments": {
        "x-max-length-bytes": 1000000,
        "x-queue-type": "stream"
      },
      "auto_delete": false,
      "durable": true,
      "name": "golden.stream",
      "type": "stream",
      "vhost": "golden"
    },
    {
      "arguments": {
        "x-queue-type": "quorum"
      },
      "auto_delete": false,
      "durable": true,
      "name": "golden.quorum",
      "type": "quorum",
      "vhost": "golden"
    },
    {
      "arguments": {
        "x-dead-letter-exchange": "golden.dlx",
        "x-max-length": 1000,
        "x-queue-type": "classic"
      },
      "auto_delete": false,
      "durable": true,
      "name": "golden.classic",
      "type": "classic",
      "vhost": "golden"
    },
    {
      "arguments": {
        "x-queue-type": "classic"
      },
      "auto_delete": false,
      "durable": true,
      "name": "default.classic",
      "type": "classic",
      "vhost": "/"
    }
  ],
  "bindings": [
    {
      "arguments": {},
      "destination": "golden.quorum",
      "destination_type": "queue",
      "routing_key": "10",
      "source": "golden.hash",
      "vhost": "golden"
    },
    {
      "arguments": {},
      "destination": "golden.classic",
      "destination_type": "queue",
      "routing_key": "orders.#",
      "source": "golden.topic",
      "vhost": "golden"
    },
    {
      "arguments": {},
      "destination": "golden.dead",
      "destination_type": "queue",
      "routing_key": "",
      "source": "golden.dlx",
      "vhost": "golden"
    },
    {
      "arguments": {
        "x-golden": "direct"
      },
      "destination": "golden.classic",
      "destination_type": "queue",
      "routing_key": "classic",
      "source": "golden.direct",
      "vhost": "golden"
    }
  ]
}
