  "libs/testkit/src/http/queues-purge.http.spec.ts": "// Generated by \`pnpm nx g @app/generators:action queues.purge\`. Requests go through the real router
// with createTestEngine().inject. They fail until createQueuesPurgeAction is implemented; do not weaken them.
import { queuesPurge, type PlanId } from '@app/contracts';
import { createRoleAuthorizer } from '@app/kernel';
import { createQueuesPurgeAction, createAdminFakeDeps } from '@app/svc-admin';
import { afterEach, describe, expect, it } from 'vitest';

import { createTestEngine, type TestEngine } from '../create-test-engine.ts';

const subject = () => createQueuesPurgeAction(createAdminFakeDeps());
const def = queuesPurge;
const KEY = 'generated-spec-key-0001';
let engine: TestEngine;

afterEach(async () => {
  await engine.close();
});

describe('POST /connections/{cid}/queues/{qkey}/purge', () => {
  it('AC-1 the route runs queues.purge and answers in the shape of the contract', async () => {
    engine = createTestEngine({ actions: [subject()] });
    engine.arm('c1');
    const answer = await engine.inject({
      method: 'POST',
      path: '/connections/c1/queues/LwBvcmRlcnM/purge',
      payload: {},
      headers: { 'idempotency-key': KEY },
    });

    expect(answer.statusCode).toBe(428);
    expect(answer.json()).toMatchObject({ code: 'PLAN_REQUIRED' });
    const planId = /\\/plans\\/([^/]+)$/.exec(
      String(answer.headers.location),
    )?.[1];
    if (planId === undefined) throw new Error('the 428 names no plan');
    const plan = await engine.executor.getPlan(
      planId as PlanId,
      engine.context(),
    );
    const done = await engine.executor.execute(
      {
        planId: plan.id,
        consents: [...plan.consentsRequired],
        confirmation: plan.confirmationPhrase,
        idempotencyKey: KEY,
      },
      engine.context(),
    );
    expect(done.kind).toBe('output');
    if (done.kind !== 'output')
      throw new Error(\`expected output, got \${done.kind}\`);
    expect(def.output.safeParse(done.output).success).toBe(true);
  });

  it('AC-2 a request without the launch token is refused and nothing runs', async () => {
    engine = createTestEngine({ actions: [subject()] });

    const answer = await engine.inject({
      method: 'POST',
      path: '/connections/c1/queues/LwBvcmRlcnM/purge',
      authenticated: false,
    });

    expect(answer.statusCode).toBe(401);
    expect(engine.audit.attempts).toEqual([]);
  });

  it('AC-3 a caller that does not hold messages.purge gets 403 and nothing runs', async () => {
    engine = createTestEngine({
      actions: [subject()],
      authorizer: createRoleAuthorizer({}),
    });
    engine.arm('c1');
    const answer = await engine.inject({
      method: 'POST',
      path: '/connections/c1/queues/LwBvcmRlcnM/purge',
      payload: {},
      headers: { 'idempotency-key': KEY },
    });

    expect(answer.statusCode).toBe(403);
    expect(answer.json()).toMatchObject({ code: 'FORBIDDEN_RBAC' });
    expect(engine.audit.attempts).toEqual([]);
    expect(engine.writeCalls).toEqual([]);
  });

  it('AC-4 input that breaks the contract is a 400 Problem and nothing runs', async () => {
    engine = createTestEngine({ actions: [subject()] });
    engine.arm('c1');
    const answer = await engine.inject({
      method: 'POST',
      path: '/connections/c1/queues/LwBvcmRlcnM/purge',
      payload: { unexpected: true },
      headers: { 'idempotency-key': KEY },
    });

    expect(answer.statusCode).toBe(400);
    expect(answer.json()).toMatchObject({ code: 'VALIDATION_FAILED' });
    expect(engine.audit.attempts).toEqual([]);
  });

  it('AC-5 another method on the same path is 405', async () => {
    engine = createTestEngine({ actions: [subject()] });

    const answer = await engine.inject({
      method: 'GET',
      path: '/connections/c1/queues/LwBvcmRlcnM/purge',
    });

    expect(answer.statusCode).toBe(405);
    expect(answer.headers.allow).toBe('POST');
  });
});
