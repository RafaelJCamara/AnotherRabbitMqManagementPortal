  "libs/engine/adapter-demo/src/adapter-demo.spec.ts": "import { describe, expect, it } from 'vitest';

import { DemoAdapter, createDemoAdapter } from './adapter-demo';

describe('DemoAdapter', () => {
  it('identifies itself by the project name', () => {
    expect(new DemoAdapter().id).toBe('adapter-demo');
  });

  it('is built by the contract-suite hook', () => {
    expect(createDemoAdapter()).toBeInstanceOf(DemoAdapter);
  });

  it.todo('passes the DemoPort contract suite against a real broker');
});
",
  "libs/engine/adapter-demo/src/adapter-demo.ts": "// The only project that may import left-pad (blueprint 2.4, eslint.config.mjs).
import type { DemoPort } from './port';

/** Implements DemoPort. Add the port's members here; the compiler lists the missing ones. */
export class DemoAdapter implements DemoPort {
  readonly id = 'adapter-demo';
}

/** The hook the shared port contract suite uses to build the adapter under test. */
export function createDemoAdapter(): DemoPort {
  return new DemoAdapter();
}
",
