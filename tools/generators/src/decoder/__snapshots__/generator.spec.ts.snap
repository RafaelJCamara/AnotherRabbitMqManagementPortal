  "libs/engine/decoders/src/builtin/masstransit.spec.ts": "import { describe, expect, it } from 'vitest';

import type { DecodeInput } from '../types';
import { masstransitDecoder } from './masstransit';

const empty: DecodeInput = {
  headers: {},
  properties: {},
  body: new Uint8Array(),
  bodyTruncated: false,
  protocol: 'amqp091',
  era: '4.3',
};

describe('masstransit decoder', () => {
  it('does not claim a message with no framework headers', () => {
    expect(masstransitDecoder.detect(empty)).toBe(0);
  });

  it.todo('decodes every message in testing/fixtures/messages/masstransit');
});
",
  "libs/engine/decoders/src/builtin/masstransit.ts": "import type { DecoderPlugin } from '../types';

export const masstransitDecoder: DecoderPlugin = {
  apiVersion: 1,
  id: 'builtin.masstransit',
  tier: 'builtin',
  frameworks: ['masstransit'],
  // 0 means "not masstransit", 1 means certain. Never claims a message until implemented.
  detect: () => 0,
  decode: () => {
    throw new Error('The masstransit decoder does not implement decode yet.');
  },
  fingerprint: () => {
    throw new Error(
      'The masstransit decoder does not implement fingerprint yet.',
    );
  },
  replayPlan: () => null,
};
",
  "libs/engine/decoders/src/index.spec.ts": "import { describe, expect, it } from 'vitest';

import * as api from './index';

describe('decoders public API', () => {
