import { queueWithoutDlx } from './queue-without-dlx';

export const lintRules: readonly LintRule[] = [queueWithoutDlx];
",
  "libs/shared/lint-rules/src/rules/queue-without-dlx.fixtures.ts": "import type { RuleFixture } from '../types';

/** One fixture per broker version on which the rule behaves differently; the first is \`since\`. */
export const queueWithoutDlxFixtures: readonly RuleFixture[] = [
  { brokerVersion: '4.3', input: {}, expected: [] },
];
",
  "libs/shared/lint-rules/src/rules/queue-without-dlx.spec.ts": "import { describe, expect, it } from 'vitest';

import { queueWithoutDlx } from './queue-without-dlx';
import { queueWithoutDlxFixtures } from './queue-without-dlx.fixtures';
import { lintRules } from './index';

describe('queue-without-dlx', () => {
  it('is registered', () => {
    expect(lintRules).toContain(queueWithoutDlx);
  });

  it('applies from broker 4.3', () => {
    expect(queueWithoutDlx.since).toBe('4.3');
  });

  it.each(queueWithoutDlxFixtures)(
    'reports the expected findings on broker $brokerVersion',
    (fixture) => {
      const messages = queueWithoutDlx
        .check(fixture.input)
        .map((finding) => finding.message);

      expect(messages).toEqual(fixture.expected);
    },
  );
});
",
  "libs/shared/lint-rules/src/rules/queue-without-dlx.ts": "import type { LintFinding, LintRule } from '../types';

export const queueWithoutDlx: LintRule = {
  id: 'queue-without-dlx',
  severity: 'error',
  since: '4.3',
  check(): readonly LintFinding[] {
    // Replace with the check. Report one finding per offending object.
    return [];
  },
};
",
  "libs/shared/lint-rules/src/types.ts": "// The shape of a broker lint rule (DC-56). Rules are data-driven and runtime-neutral: they run
// in the engine, the CLI and the browser, so this library has no Node dependency.
export type LintSeverity = 'info' | 'warn' | 'error';

export interface LintFinding {
  readonly ruleId: string;
  readonly severity: LintSeverity;
  readonly message: string;
}

export interface LintRule {
  readonly id: string;
  readonly severity: LintSeverity;
  /** First broker version the rule applies to, for example 4.3. */
  readonly since: string;
  /** The input is the topology or profile snapshot; narrow it inside the rule. */
  check(input: unknown): readonly LintFinding[];
}

/** One fixture per broker version on which the rule behaves differently. */
export interface RuleFixture {
  readonly brokerVersion: string;
  readonly input: unknown;
  /** Messages of the findings the rule must report, in order. */
  readonly expected: readonly string[];
}
",
