  "libs/engine/persistence/src/migrate/helpers.ts": "/** The storage dialects: desktop and local (sqlite), team server (pg). */
export type DialectName = 'sqlite' | 'pg';

/** Column types for DDL, one method per helper (\`db.t.id()\`, \`db.t.bytes()\`, ...). */
export interface ColumnTypes {
  id(): string;
  json(): string;
  epochMs(): string;
  bytes(): string;
}

export function columnTypes(dialect: DialectName): ColumnTypes {
  return {
    id: () => 'TEXT',
    json: () => 'TEXT',
    epochMs: () => 'BIGINT',
    bytes: () => (dialect === 'pg' ? 'BYTEA' : 'BLOB'),
  };
}
",
  "libs/engine/persistence/src/migrate/types.ts": "import type { ColumnTypes, DialectName } from './helpers';

/** The statement runner a migration receives; the migration runner implements it. */
export interface SqlExecutor {
  readonly dialect: DialectName;
  readonly t: ColumnTypes;
  execute(sql: string): Promise<void>;
}

export interface Migration {
  /** \`NNNN_name\`, equal to the file name without the extension. */
  readonly id: string;
  up(db: SqlExecutor): Promise<void>;
}
",
  "libs/engine/persistence/src/migrations/0001_core.spec.ts": "import { describe, expect, it } from 'vitest';

import { columnTypes } from '../migrate/helpers';
import { migration0001Core } from './0001_core';

describe('0001_core', () => {
  it('has an id equal to its file name', () => {
    expect(migration0001Core.id).toBe('0001_core');
  });

  it('runs the statements it declares', async () => {
    const statements: string[] = [];

    await migration0001Core.up({
      dialect: 'sqlite',
      t: columnTypes('sqlite'),
      execute: (sql) => {
        statements.push(sql);
        return Promise.resolve();
      },
    });

    // Assert the DDL here once the migration has some.
    expect(statements).toEqual([]);
  });
});
",
  "libs/engine/persistence/src/migrations/0001_core.ts": "import type { Migration } from '../migrate/types';

export const migration0001Core: Migration = {
  id: '0001_core',
  // Replace with the DDL, one db.execute call per statement. Write SQL both SQLite and Postgres
  // accept, and use db.t.id(), db.t.json(), db.t.epochMs() and db.t.bytes() where they differ.
  up: () => Promise.resolve(),
};
",
  "libs/engine/persistence/src/migrations/index.spec.ts": "import { describe, expect, it } from 'vitest';

import { migrations } from './index';

describe('migrations', () => {
  it('are numbered 0001, 0002, ... without gaps, in order', () => {
    const numbers = migrations.map((migration) => migration.id.slice(0, 4));

    expect(numbers).toEqual(
      migrations.map((_, index) => String(index + 1).padStart(4, '0')),
    );
  });

  it('have ids of the form NNNN_name', () => {
    for (const migration of migrations) {
      expect(migration.id).toMatch(/^\\d{4}_[a-z0-9_]+$/);
    }
  });
});
",
  "libs/engine/persistence/src/migrations/index.ts": "import type { Migration } from '../migrate/types';
import { migration0001Core } from './0001_core';

export const migrations: readonly Migration[] = [migration0001Core];
