exports[`service-module > creates the uniform service shape for svc-demo > spec 1`] = `
"import { describe, expect, it } from 'vitest';

import { createDemoModule } from './module';

describe('createDemoModule', () => {
  it('registers the module under the project name', () => {
    expect(createDemoModule({}).id).toBe('svc-demo');
  });

  it('starts without actions, topics or jobs', () => {
    const module = createDemoModule({});

    expect(module.actions).toEqual([]);
    expect(module.topics).toEqual([]);
    expect(module.jobs).toEqual([]);
  });
});
"
`;
