",
  "libs/shared/contracts/src/registry/tap-messages-topic.ts": "// tap.messages: a live topic (credit, sampled).
// Generated by \`pnpm nx g @app/generators:topic tap.messages\`. Describe the real params and item
// below, then run \`pnpm nx run contracts:api-docs\` so the AsyncAPI document follows. An item
// never carries a write-only secret, and the ring is bounded by items and bytes (I-6).
import { z } from 'zod';

import { defineTopic } from '../kit/define-topic.ts';

export const TapMessagesParamsSchema = z.strictObject({});

export const TapMessagesItemSchema = z.strictObject({
  id: z.string().min(1),
});

export const tapMessagesTopic = defineTopic({
  id: 'tap.messages',
  params: TapMessagesParamsSchema,
  item: TapMessagesItemSchema,
  qos: 'sampled',
  flow: 'credit',
