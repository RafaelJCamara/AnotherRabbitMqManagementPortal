// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`topic generator: what it creates > creates a keyed snapshot-delta topic with a latest rate 1`] = `
{
  "libs/engine/svc-tap/src/topics.explorer-window-topic.fixture.ts": "// What topics.explorer-window-topic.spec.ts checks. Edit this file, not the spec, as the topic grows.

/** Params that pass the topic's params schema. */
export const sampleParams = {};

/** An item that passes the topic's item schema. */
export const sampleItem = { id: 'item-1' };
",
  "libs/engine/svc-tap/src/topics.explorer-window-topic.spec.ts": "// Generated by \`pnpm nx g @app/generators:topic explorer.window\`. It holds the topic to the kit
// invariants and to the live frames it travels in. Do not weaken it.
import {
  ClientFrameSchema,
  ServerFrameSchema,
  checkRegistry,
  explorerWindowTopic,
} from '@app/contracts';
import { describe, expect, it } from 'vitest';

import { createTapModule } from './module';
import { createTapFakeDeps } from './testing';
import {
  sampleItem,
  sampleParams,
} from './topics.explorer-window-topic.fixture';

const topic = explorerWindowTopic;

describe('explorer.window', () => {
  it('AC-1 the contract passes the kit invariants: bounded ring, keyed, no secret', () => {
    expect(checkRegistry({ actions: [], topics: [topic] })).toEqual([]);
    // Bounded by items and by bytes (I-6): whatever the numbers are, both are finite.
    expect(Number.isSafeInteger(topic.ring.items) && topic.ring.items > 0).toBe(
      true,
    );
    expect(Number.isSafeInteger(topic.ring.bytes) && topic.ring.bytes > 0).toBe(
      true,
    );
  });

  it('AC-2 the sample params and item fit the schemas, and travel in live frames', () => {
    const item = topic.item.parse(sampleItem);

    expect(topic.params.safeParse(sampleParams).success).toBe(true);
    expect(
      ClientFrameSchema.safeParse({
        t: 'sub',
        sid: 1,
        topic: topic.id,
        params: sampleParams,
        credit: 16,
      }).success,
    ).toBe(true);
    expect(
      ServerFrameSchema.safeParse({
        t: 'snapshot',
        sid: 1,
        seq: 1,
        items: [item],
      }).success,
    ).toBe(true);
    expect(
      ServerFrameSchema.safeParse({
        t: 'delta',
        sid: 1,
        seq: 2,
        upserts: [item],
        removes: [topic.key?.(item) ?? ''],
      }).success,
    ).toBe(true);
  });

  it('AC-3 an item has one stable key, so coalescing and removals agree', () => {
    const first = topic.key?.(topic.item.parse(sampleItem));
    const second = topic.key?.(topic.item.parse({ ...sampleItem }));

    expect(typeof first).toBe('string');
    expect(first).toBe(second);
  });

  it('AC-4 the module declares the topic', () => {
    expect(createTapModule(createTapFakeDeps()).topics).toContain(topic);
  });

  it.todo(
    'AC-5 a provider feeds the topic: wired through the live hub (M0-33)',
  );
});
",
  "libs/shared/contracts/src/registry/explorer-window-topic.ts": "// explorer.window: a live topic (snapshot-delta, latest).
// Generated by \`pnpm nx g @app/generators:topic explorer.window\`. Describe the real params and item
// below, then run \`pnpm nx run contracts:api-docs\` so the AsyncAPI document follows. An item
// never carries a write-only secret, and the ring is bounded by items and bytes (I-6).
import { z } from 'zod';

import { defineTopic } from '../kit/define-topic.ts';

export const ExplorerWindowParamsSchema = z.strictObject({});

export const ExplorerWindowItemSchema = z.strictObject({
  id: z.string().min(1),
});

export const explorerWindowTopic = defineTopic({
  id: 'explorer.window',
  params: ExplorerWindowParamsSchema,
  item: ExplorerWindowItemSchema,
  qos: 'latest',
  flow: 'snapshot-delta',
  permission: 'broker.read',
  key: (item) => item.id,
  maxHz: 4,
  ring: { items: 500, bytes: 262144 },
});
",
}
`;

