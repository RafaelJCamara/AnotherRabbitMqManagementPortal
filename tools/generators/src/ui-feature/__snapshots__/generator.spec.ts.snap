  "libs/ui/feature-demo/src/lib/demo.component.html": "<section>
  <h1>{{ titleKey }}</h1>
</section>
",
  "libs/ui/feature-demo/src/lib/demo.component.ts": "import { ChangeDetectionStrategy, Component } from '@angular/core';

@Component({
  selector: 'app-demo',
  templateUrl: './demo.component.html',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class DemoComponent {
  /** Copy comes from the i18n scope (src/i18n/en.json), never from the template. */
  protected readonly titleKey = 'demo.title';
}
",
  "libs/ui/feature-demo/src/lib/demo.route.spec.ts": "import { describe, expect, it } from 'vitest';

import { demoRoute } from './demo.route';

describe('demoRoute', () => {
  it('mounts at c/:cid/demo', () => {
    expect(demoRoute.path).toBe('c/:cid/demo');
  });

  it('lazy-loads its child routes', () => {
    expect(demoRoute.loadChildren).toBeTypeOf('function');
  });
});
",
  "libs/ui/feature-demo/src/lib/demo.route.ts": "import type { Route } from '@angular/router';

/**
 * Mounted by the web shell. The feature code is lazy: it loads when the route is first visited,
 * so a feature never adds to the initial bundle.
 */
export const demoRoute: Route = {
  path: 'c/:cid/demo',
  loadChildren: () => import('./demo.routes').then((m) => m.demoRoutes),
};
",
  "libs/ui/feature-demo/src/lib/demo.routes.ts": "import type { Routes } from '@angular/router';

export const demoRoutes: Routes = [
  {
    path: '',
    loadComponent: () =>
      import('./demo.component').then((m) => m.DemoComponent),
  },
];
",
