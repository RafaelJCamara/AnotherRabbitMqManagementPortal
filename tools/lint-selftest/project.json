{
  "name": "lint-selftest",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/lint-selftest/src",
  "tags": ["type:test", "runtime:node"],
  "implicitDependencies": ["eslint-rules"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc -p tools/lint-selftest/tsconfig.lib.json --noEmit",
          "tsc -p tools/lint-selftest/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "command": "vitest run --config tools/lint-selftest/vitest.config.mts"
      }
    }
  }
}
