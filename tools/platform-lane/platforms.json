{
  "description": "The pinned platform set of the platform upgrade lane (A-25, docs/runbooks/platform-upgrade-lane.md). Each entry says where its pin lives, which majors count, the runbook target, and the registry-metadata checks run before an upgrade issue is opened. A pin read from the catalog, .nvmrc or packageManager is never copied here; `fallback` is the planned pin of a platform the repository has not installed yet and stops being used once the catalog has it.",
  "platforms": [
    {
      "id": "node",
      "name": "Node",
      "source": "node",
      "pin": { "kind": "nvmrc" },
      "majors": "even",
      "cadence": "Move the container and team images to Node 26 well before Node 24 reaches EOL (2028-04-30).",
      "windowDays": null,
      "adrGated": false,
      "renovate": { "groupName": "node", "packages": ["node", "@types/node"] },
      "checks": [
        {
          "id": "node-angular",
          "label": "Pinned @angular/core accepts the new Node",
          "kind": "engines-node",
          "package": "@angular/core",
          "at": "pinned",
          "subject": { "platform": "node", "version": "target" }
        },
        {
          "id": "node-vitest",
          "label": "Pinned vitest accepts the new Node",
          "kind": "engines-node",
          "package": "vitest",
          "at": "pinned",
          "subject": { "platform": "node", "version": "target" }
        },
        {
          "id": "node-eslint",
          "label": "Pinned eslint accepts the new Node",
          "kind": "engines-node",
          "package": "eslint",
          "at": "pinned",
          "subject": { "platform": "node", "version": "target" }
        },
        {
          "id": "node-pnpm",
          "label": "Pinned pnpm accepts the new Node",
          "kind": "engines-node",
          "package": "pnpm",
          "at": "pinned",
          "subject": { "platform": "node", "version": "target" }
        }
      ]
    },
    {
      "id": "pnpm",
      "name": "pnpm",
      "source": "npm",
      "package": "pnpm",
      "pin": { "kind": "package-manager", "name": "pnpm" },
      "majors": "all",
      "cadence": "Maintainer applies the bump: the supply-chain keys of pnpm-workspace.yaml are protected paths.",
      "windowDays": null,
      "adrGated": false,
      "renovate": { "groupName": "pnpm", "packages": ["pnpm"] },
      "checks": [
        {
          "id": "pnpm-node",
          "label": "New pnpm accepts the pinned Node",
          "kind": "engines-node",
          "package": "pnpm",
          "at": "target",
          "subject": { "platform": "node", "version": "pinned" }
        }
      ]
    },
    {
