{
  "name": "semantics-audit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/semantics-audit",
  "tags": ["type:tooling", "runtime:node"],
  "implicitDependencies": ["semantics", "domain-model", "contracts"],
  "targets": {
    "lint": {},
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/libs/shared/semantics/src/**/*.ts",
        "{workspaceRoot}/libs/shared/domain-model/src/**/*.ts",
        "{workspaceRoot}/libs/shared/contracts/src/**/*.ts"
      ],
      "options": {
        "command": "tsc -p tools/semantics-audit/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{projectRoot}/register.mjs",
        "{workspaceRoot}/libs/shared/semantics/src/**/*.ts",
        "{workspaceRoot}/libs/shared/domain-model/src/**/*.ts",
        "{workspaceRoot}/libs/shared/contracts/src/**/*.ts"
      ],
      "options": {
        "command": "vitest run --config tools/semantics-audit/vitest.config.mts"
      }
    }
  }
}
