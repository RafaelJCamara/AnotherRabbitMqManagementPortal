{
  "name": "web-gallery-check",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/web-gallery-check",
  "tags": ["type:tooling", "runtime:node"],
  "targets": {
    "lint": {},
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/libs/ui/charts/src/**/*",
        "{workspaceRoot}/libs/ui/feature-explorer/src/**/*"
      ],
      "options": {
        "command": "node --test tools/web-gallery-check/check-no-gallery.test.mjs tools/web-gallery-check/explorer-i18n-source.test.mjs tools/web-gallery-check/connections-i18n-source.test.mjs tools/web-gallery-check/charts-source.test.mjs"
      }
    },
    "gallery-absent": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "^production",
        "{workspaceRoot}/apps/web/project.json",
        "{workspaceRoot}/libs/ui/design/src/**/*"
      ],
      "options": {
        "commands": [
          "nx run web:build:production --output-path=dist/gallery-check/production",
          "nx run web:build:development --output-path=dist/gallery-check/development",
          "node tools/web-gallery-check/check-no-gallery.mjs dist/gallery-check/production/browser dist/gallery-check/development/browser"
        ],
        "parallel": false
      }
    }
  }
}
