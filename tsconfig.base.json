{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "paths": {
      "@app/broker-lab": ["./testing/broker-lab/src/index.ts"],
      "@app/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@app/domain-model": ["./libs/shared/domain-model/src/index.ts"],
      "@app/generators": ["./tools/generators/src/index.ts"],
      "@app/kernel": ["./libs/engine/kernel/src/index.ts"],
      "@app/live-protocol": ["./libs/shared/live-protocol/src/index.ts"],
      "@app/persistence": ["./libs/engine/persistence/src/index.ts"],
      "@app/semantics": ["./libs/shared/semantics/src/index.ts"],
      "@app/testkit": ["./libs/testkit/src/index.ts"],
      "@lint-fixtures/contracts-lib": [
        "./tools/lint-selftest/fixtures/contracts-lib/src/index.ts"
      ],
      "@lint-fixtures/pure-lib": [
        "./tools/lint-selftest/fixtures/pure-lib/src/index.ts"
      ],
      "@lint-fixtures/service-a": [
        "./tools/lint-selftest/fixtures/service-a/src/index.ts"
      ],
      "@lint-fixtures/service-b": [
        "./tools/lint-selftest/fixtures/service-b/src/index.ts"
      ],
      "@lint-fixtures/ui-data": [
        "./tools/lint-selftest/fixtures/ui-data/src/index.ts"
      ],
      "@lint-fixtures/ui-feature-a": [
        "./tools/lint-selftest/fixtures/ui-feature-a/src/index.ts"
      ],
      "@lint-fixtures/ui-feature-b": [
        "./tools/lint-selftest/fixtures/ui-feature-b/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
