{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "paths": {
      "@app/adapter-amqp091": ["./libs/engine/adapter-amqp091/src/index.ts"],
      "@app/adapter-mgmt-http": [
        "./libs/engine/adapter-mgmt-http/src/index.ts"
      ],
      "@app/arch-tests": ["./tools/arch-tests/src/index.ts"],
      "@app/broker-lab": ["./testing/broker-lab/src/index.ts"],
      "@app/conformance-ci": ["./tools/conformance-ci/src/index.ts"],
      "@app/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@app/domain-model": ["./libs/shared/domain-model/src/index.ts"],
      "@app/generators": ["./tools/generators/src/index.ts"],
      "@app/jobs": ["./libs/engine/jobs/src/index.ts"],
      "@app/kernel": ["./libs/engine/kernel/src/index.ts"],
      "@app/live": ["./libs/engine/live/src/index.ts"],
      "@app/live-protocol": ["./libs/shared/live-protocol/src/index.ts"],
      "@app/net-dialer": ["./libs/engine/net-dialer/src/index.ts"],
      "@app/net-truststore": ["./libs/engine/net-truststore/src/index.ts"],
      "@app/net-truststore/testing": [
        "./libs/engine/net-truststore/src/testing/index.ts"
      ],
      "@app/persistence": ["./libs/engine/persistence/src/index.ts"],
      "@app/ports": ["./libs/engine/ports/src/index.ts"],
      "@app/ports/testing": ["./libs/engine/ports/src/testing/index.ts"],
      "@app/secrets": ["./libs/engine/secrets/src/index.ts"],
      "@app/semantics": ["./libs/shared/semantics/src/index.ts"],
      "@app/semantics-evidence": ["./tools/semantics-evidence/src/index.ts"],
      "@app/svc-capabilities": ["./libs/engine/svc-capabilities/src/index.ts"],
      "@app/svc-connections": ["./libs/engine/svc-connections/src/index.ts"],
      "@app/svc-ops": ["./libs/engine/svc-ops/src/index.ts"],
      "@app/svc-workspace": ["./libs/engine/svc-workspace/src/index.ts"],
      "@app/testkit": ["./libs/testkit/src/index.ts"],
      "@app/transport": ["./libs/engine/transport/src/index.ts"],
      "@app/ui-data": ["./libs/ui/data/src/index.ts"],
      "@app/ui-design": ["./libs/ui/design/src/index.ts"],
      "@app/ui-platform": ["./libs/ui/platform/src/index.ts"],
      "@app/ui-platform/testing": ["./libs/ui/platform/src/testing/index.ts"],
      "@lint-fixtures/contracts-lib": [
        "./tools/lint-selftest/fixtures/contracts-lib/src/index.ts"
      ],
      "@lint-fixtures/pure-lib": [
        "./tools/lint-selftest/fixtures/pure-lib/src/index.ts"
      ],
      "@lint-fixtures/service-a": [
        "./tools/lint-selftest/fixtures/service-a/src/index.ts"
      ],
      "@lint-fixtures/service-b": [
        "./tools/lint-selftest/fixtures/service-b/src/index.ts"
      ],
      "@lint-fixtures/ui-data": [
        "./tools/lint-selftest/fixtures/ui-data/src/index.ts"
      ],
      "@lint-fixtures/ui-feature-a": [
        "./tools/lint-selftest/fixtures/ui-feature-a/src/index.ts"
      ],
      "@lint-fixtures/ui-feature-b": [
        "./tools/lint-selftest/fixtures/ui-feature-b/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
